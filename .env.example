# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#
# Secrets live here; behaviour lives in `config/*.yaml`. Anything that changes
# what the pipeline *does* (countries, thresholds, tiers, concurrency, rate
# limits, retry policy) belongs in configuration, not in this file.
#
# Keys are added by the phase that first needs them, so this file always
# reflects what the code actually reads.

# --- Loader controls (single underscore) ------------------------------------
# Profile overlay applied on top of config/*.yaml. Must name a file in
# config/profiles/ — a profile that does not exist is an error, not a silent
# fallback to baseline. Leave unset for the committed baseline.
# PROSPECTING_PROFILE=dev

# Directory searched for configuration files. Defaults to <project_root>/config.
# PROSPECTING_CONFIG_DIR=

# --- Value overrides (double underscore) ------------------------------------
# PROSPECTING__<SECTION>__<KEY> overrides one setting, taking precedence over
# both the baseline and the profile. The double underscore separates path
# segments, because single underscores appear inside setting names.
#
# Values are parsed as JSON when possible, so numbers, booleans, and lists all
# survive; anything else is treated as a plain string.
#
#   PROSPECTING__LOG__LEVEL=DEBUG
#   PROSPECTING__RUNTIME__MAX_CONCURRENT_REQUESTS=4
#   PROSPECTING__BUDGET__ENABLED=false
#   PROSPECTING__ICP__PRIORITY_COUNTRIES=["GB","FR"]
#
# Every override applied is recorded in Settings.meta.environment_overrides and
# reported at startup, so a machine-specific override is never invisible.

# --- Providers (added when the corresponding adapter is implemented) --------
# ANTHROPIC_API_KEY=
# FIRECRAWL_API_KEY=
# SERPER_API_KEY=
