# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
credentials.json

# ---------------------------------------------------------------------------
# Pipeline data
#
# Run artefacts are reproducible from the master file and configuration, and
# they contain personal data subject to the retention policy in ARCHITECTURE.md
# §4.8. Neither belongs in version control.
#
# The master file (data/master/artists.jsonl) is the durable business asset and
# is likewise excluded: it grows continuously, contains personal data, and needs
# a backup strategy rather than a commit history.
# ---------------------------------------------------------------------------
data/raw/**
data/interim/**
data/exports/**
data/master/**
!data/**/.gitkeep

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# ---------------------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Local tooling state (machine-specific, not shared)
# ---------------------------------------------------------------------------
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Firecrawl local cache and spike outputs
# ---------------------------------------------------------------------------
.firecrawl/
spikes/**/out/

# ---------------------------------------------------------------------------
# Delivered leads
#
# run_pipeline.py copies the finished sheets here for the operator. They are
# real artists' names, email addresses and phone numbers — the same personal
# data the retention policy covers — and they are reproducible for free from the
# cache with `python run_pipeline.py --budget 0`. Neither fact argues for
# committing them.
#
# STATUS_REPORT.html is the same thing in a different format: a rendered leads
# table naming real artists and their personal addresses. Generated by
# build_report.py, reproducible for free, and not something to publish.
# ---------------------------------------------------------------------------
output/
STATUS_REPORT.html

# ---------------------------------------------------------------------------
# Local agent tooling (machine-specific, not part of the project)
#
# .claude/skills/ holds third-party skill packages fetched by a skill manager,
# the same way node_modules holds fetched packages. They are not this project's
# code and pin to whichever machine installed them.
# ---------------------------------------------------------------------------
.agents/
skills-lock.json
.claude/skills/
